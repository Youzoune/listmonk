[app]
# Interface and port where the app will run its webserver.  The default value
# of localhost will only listen to connections from the current machine. To
# listen on all interfaces use '0.0.0.0'. To listen on the default web address
# port, use port 80 (this will require running with elevated permissions).
address = "localhost:9000"

# Projects (YZN-214). Like Twenty's workspaces, every project but the default
# one gets the subdomain <project-identifier>.<domain> for its public pages and
# the links in its e-mails. Point a wildcard DNS record (*.<domain>) at this
# server and serve it with a wildcard certificate, or let Caddy get one per
# subdomain on demand (see docs/youzoune/pages-publiques.md).
# Env: LISTMONK_projects__domain
[projects]
domain = ""

# Database.
[db]
host = "localhost"
port = 5432
user = "listmonk"
password = "listmonk"

# Ensure that this database has been created in Postgres.
database = "listmonk"

ssl_mode = "disable"
max_open = 25
max_idle = 25
max_lifetime = "300s"

# Optional space separated Postgres DSN params. eg: "application_name=listmonk gssencmode=disable"
params = ""
